# Copy this file to .env.local and fill in the real values from your Supabase
# project (Project Settings > Data API). .env.local is gitignored.
#
# These same two variables also need to be added in Vercel:
# Project Settings > Environment Variables.
#
# The anon key is meant to be public — it ships in the browser bundle. The
# table's row-level security policies are what actually protect the data.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
